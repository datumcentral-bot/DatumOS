{
  "name": "datumos",
  "version": "1.0.0",
  "private": true,
  "description": "DatumOS — Custom ERP + Client Portal for Datum Studios Engineering Consultancy",
  "scripts": {
    "dev": "next dev",
    "build": "npm test && prisma generate && next build",
    "start": "node server.js",
    "lint": "next lint",
    "test": "node --test src/lib/roles.test.mjs tests/extraction.test.mjs",
    "test:operations": "node --test tests/operations.test.mjs",
    "dev:local": "node scripts/start-local.mjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.mjs && node prisma/seed-v11.mjs",
    "db:seed:v11": "node prisma/seed-v11.mjs",
    "setup": "prisma generate && prisma migrate dev --name init && node prisma/seed.mjs"
  },
  "prisma": {
    "seed": "node prisma/seed.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@neon/auth": "^0.8.2",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "livekit-client": "^2.22.3",
    "lucide-react": "^0.454.0",
    "next": "15.5.29",
    "next-auth": "^4.24.14",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^2.5.4",
    "undici": "^8.11.2"
  },
  "devDependencies": {
    "@neon/config": "^1.14.5",
    "@neon/env": "^2.1.8",
    "@playwright/test": "^1.63.0",
    "autoprefixer": "^10.4.20",
    "neon": "^9.8.0",
    "postcss": "^8.4.47",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.14"
  }
}
